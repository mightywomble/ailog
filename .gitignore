# .gitignore

# Ignore the scheduler configuration file which contains secrets
scheduler_config.json

# Ignore Python virtual environment
venv/

# Ignore Python cache files
__pycache__/
*.pyc

hosts.json

# Local database artifacts
instance/*.db
instance/*.db-journal
instance/*.db-wal

# Local runtime / database artifacts
instance/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Environment files
.env
.env.*
# ...but the checklist is part of the project, not a secret. deploy/compose/
# <name>/.env.example is how a project says which keys its host .env must
# define; the wrong pattern here kept it out of the repository while every
# `git add -A` said it was clean.
!.env.example

# Local backups / scratch copies
*.backup
templates/*_old.html
templates/*.backup
