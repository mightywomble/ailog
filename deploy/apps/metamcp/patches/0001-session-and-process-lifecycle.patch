@@ -0,0 +1,105 @@
+import { describe, expect, it, vi } from "vitest";
+
+import { processGroupRegistry } from "../stdio-transport/process-registry";
+import { connectMetaMcpClient } from "./client";
+import { serverErrorTracker } from "./server-error-tracker";
+
+/**
+ * Regression test for the failed-connect leak (#324 / #128 residuals).
+ *
+ * `client.connect()` spawns the STDIO server *before* the MCP handshake
+ * completes. When the handshake fails (cold `npx`/`uvx` start is the common
+ * case) the old code caught the error and retried without closing the transport,
+ * leaving a detached ~95 MB `npm exec` process that nothing tracked.
+ */
+describe("connectMetaMcpClient failed attempts", () => {
+  it("closes the transport of every failed attempt before retrying", async () => {
+    vi.spyOn(serverErrorTracker, "getServerMaxAttempts").mockResolvedValue(3);
+    vi.spyOn(serverErrorTracker, "isServerInErrorState").mockResolvedValue(
+      false,
+    );
+    const closes: number[] = [];
+    let attempt = 0;
+
+    const createClient = vi.fn(() => {
+      attempt += 1;
+      const transport = {
+        start: vi.fn(),
+        close: vi.fn(async () => {
+          closes.push(attempt);
+        }),
+        send: vi.fn(),
+      };
+      const client = {
+        connect: vi.fn(async () => {
+          throw new Error("handshake timed out");
+        }),
+        close: vi.fn(async () => undefined),
+      };
+      return {
+        client: client as never,
+        transport: transport as never,
+      };
+    });
+
+    await connectMetaMcpClient(
+      {
+        uuid: "11111111-1111-1111-1111-111111111111",
+        name: "mock-stdio",
+        type: "STDIO",
+        command: "npx",
+        args: ["--yes", "some-mcp"],
+        env: {},
+        createdAt: new Date(),
+        status: "ACTIVE",
+      } as never,
+      undefined,
+      { createClient: createClient as never, retryDelayMs: 1 },
+    );
+
+    // Three attempts, one close each. Before the fix `closes` was empty: the
+    // transport from every failed attempt was simply abandoned.
+    expect(createClient.mock.calls.length).toBe(3);
+    expect(closes).toEqual([1, 2, 3]);
+  });
+
+  it("does not close anything when the first attempt succeeds", async () => {
+    const closeSpy = vi.fn(async () => undefined);
+
+    vi.spyOn(serverErrorTracker, "getServerMaxAttempts").mockResolvedValue(3);
+    vi.spyOn(serverErrorTracker, "isServerInErrorState").mockResolvedValue(
+      false,
+    );
+    const createClient = vi.fn(() => ({
+      client: {
+        connect: vi.fn(async () => undefined),
+        close: vi.fn(async () => undefined),
+      } as never,
+      transport: {
+        start: vi.fn(),
+        close: closeSpy,
+        send: vi.fn(),
+        pid: undefined,
+      } as never,
+    }));
+
+    const connected = await connectMetaMcpClient(
+      {
+        uuid: "22222222-2222-2222-2222-222222222222",
+        name: "mock-stdio-ok",
+        type: "STDIO",
+        command: "npx",
+        args: [],
+        env: {},
+        createdAt: new Date(),
+        status: "ACTIVE",
+      } as never,
+      undefined,
+      { createClient: createClient as never, retryDelayMs: 1 },
+    );
+
+    expect(connected).toBeDefined();
+    expect(closeSpy).not.toHaveBeenCalled();
+    expect(processGroupRegistry.size).toBe(0);
+  });
+});
