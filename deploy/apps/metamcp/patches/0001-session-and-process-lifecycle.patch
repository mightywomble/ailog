diff --git a/apps/backend/src/lib/metamcp/mcp-server-pool.test.ts b/apps/backend/src/lib/metamcp/mcp-server-pool.test.ts
new file mode 100644
index 0000000..d89b253
--- /dev/null
+++ b/apps/backend/src/lib/metamcp/mcp-server-pool.test.ts
@@ -0,0 +1,266 @@
+import type { ServerParameters } from "@repo/zod-types";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { configService } from "../config.service";
+import type { ConnectedClient } from "./client";
+import { McpServerPool } from "./mcp-server-pool";
+
+const SERVER_UUID = "aaaaaaaa-0000-0000-0000-000000000001";
+
+const params: ServerParameters = {
+  uuid: SERVER_UUID,
+  name: "mock-stdio",
+  type: "STDIO",
+  command: "npx",
+  args: ["--yes", "mock-mcp"],
+  env: {},
+  createdAt: new Date(),
+  status: "ACTIVE",
+} as unknown as ServerParameters;
+
+interface Harness {
+  pool: McpServerPool;
+  connectors: number;
+  cleanups: number;
+}
+
+function makeConnector(): {
+  connect: () => Promise<ConnectedClient>;
+  stats: Harness;
+} {
+  const stats = { connectors: 0, cleanups: 0 } as Harness;
+  return {
+    stats,
+    connect: async () => {
+      stats.connectors += 1;
+      return {
+        client: {
+          request: vi.fn(),
+          getServerCapabilities: vi.fn(() => ({ tools: {} })),
+          close: vi.fn(async () => undefined),
+        } as never,
+        cleanup: async () => {
+          stats.cleanups += 1;
+        },
+        label: "mock-stdio",
+      };
+    },
+  };
+}
+
+let harness: Harness;
+let pool: McpServerPool;
+
+beforeEach(() => {
+  // Cap = 1 keeps the warm-pool warm-up out of the connection counts.
+  process.env.METAMCP_MAX_SESSIONS_PER_SERVER = "1";
+  const connector = makeConnector();
+  pool = McpServerPool.createForTest({
+    connectClient: connector.connect as never,
+  });
+  harness = connector.stats as unknown as Harness;
+  harness.pool = pool;
+});
+
+afterEach(async () => {
+  await pool.cleanupAll();
+  delete process.env.METAMCP_MAX_SESSIONS_PER_SERVER;
+  vi.restoreAllMocks();
+});
+
+describe("McpServerPool transient sessions", () => {
+  it("opens exactly one connection for 20 parallel users of the same session", async () => {
+    vi.spyOn(configService, "getSessionLifetime").mockResolvedValue(60_000);
+
+    const sessionId = "session-1";
+    const results = await Promise.all(
+      Array.from({ length: 20 }, (_, i) =>
+        pool.withTransientSession(sessionId, SERVER_UUID, params, async () => {
+          await new Promise((resolve) => setTimeout(resolve, 5));
+          return i;
+        }),
+      ),
+    );
+
+    expect(results).toHaveLength(20);
+    expect(harness.connectors).toBe(1);
+    // everyone released: refCount back to zero
+    expect(pool.getPoolStatus().active).toBe(1);
+  });
+
+  it("does not close a session while a request is in flight", async () => {
+    vi.spyOn(configService, "getSessionLifetime").mockResolvedValue(0);
+    const sessionId = "session-2";
+
+    let release!: () => void;
+    const gate = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+
+    const inflight = pool.withTransientSession(
+      sessionId,
+      SERVER_UUID,
+      params,
+      async () => {
+        await gate;
+      },
+    );
+
+    // let acquire() complete
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    await pool.cleanupSession(sessionId, "test");
+    expect(harness.cleanups).toBe(0);
+
+    release();
+    await inflight;
+    await pool.cleanupSession(sessionId, "test");
+    expect(harness.cleanups).toBe(1);
+  });
+});
+
+describe("McpServerPool eviction", () => {
+  it("evicts an idle session once it outlives the lifetime", async () => {
+    vi.spyOn(configService, "getSessionLifetime").mockResolvedValue(50);
+
+    await pool.getSession("session-3", SERVER_UUID, params);
+    expect(harness.connectors).toBe(1);
+
+    await new Promise((resolve) => setTimeout(resolve, 120));
+    await pool.runCleanupNow();
+
+    expect(harness.cleanups).toBe(1);
+    expect(pool.getPoolStatus().active).toBe(0);
+    expect(pool.getPoolStatus().idle).toBe(0);
+  });
+
+  it("never evicts when the lifetime is explicitly infinite", async () => {
+    vi.spyOn(configService, "getSessionLifetime").mockResolvedValue(null);
+
+    await pool.getSession("session-4", SERVER_UUID, params);
+    await new Promise((resolve) => setTimeout(resolve, 60));
+    await pool.runCleanupNow();
+
+    expect(harness.cleanups).toBe(0);
+    expect(pool.getPoolStatus().active).toBe(1);
+  });
+});
+
+describe("McpServerPool per-server cap", () => {
+  it("refuses a fourth session for the same server and logs it", async () => {
+    vi.spyOn(configService, "getSessionLifetime").mockResolvedValue(60_000);
+    const warn = vi.spyOn(console, "warn").mockImplementation(() => undefined);
+
+    const first = await pool.getSession("cap-1", SERVER_UUID, params);
+    expect(first).toBeDefined();
+    // cap is 1 in this harness: the second session must be refused
+    const second = await pool.getSession("cap-2", SERVER_UUID, params);
+
+    expect(second).toBeUndefined();
+    expect(warn).toHaveBeenCalledWith(
+      expect.stringContaining("cap of 1 concurrent sessions reached"),
+    );
+    expect(harness.connectors).toBe(1);
+  });
+});
+
+describe("McpServerPool stale active sessions", () => {
+  it("expires an active session whose client never sent DELETE", async () => {
+    vi.spyOn(configService, "getSessionLifetime").mockResolvedValue(50);
+
+    await pool.getSession("session-5", SERVER_UUID, params);
+    expect(pool.getPoolStatus().active).toBe(1);
+    expect(harness.cleanups).toBe(0);
+
+    await new Promise((resolve) => setTimeout(resolve, 120));
+    await pool.runCleanupNow();
+
+    // Without aging, this connection pins a per-server slot forever and the
+    // cap ends up refusing every new client.
+    expect(pool.getPoolStatus().active).toBe(0);
+    expect(harness.cleanups).toBe(1);
+  });
+
+  it("does not expire an old session that is still being used", async () => {
+    vi.spyOn(configService, "getSessionLifetime").mockResolvedValue(300);
+
+    await pool.getSession("session-6", SERVER_UUID, params);
+    // outlive the lifetime of the *session*, but keep using it
+    await new Promise((resolve) => setTimeout(resolve, 400));
+    await pool.withTransientSession(
+      "session-6",
+      SERVER_UUID,
+      params,
+      async () => "used",
+    );
+
+    await pool.runCleanupNow();
+
+    expect(pool.getPoolStatus().active).toBe(1);
+    expect(harness.cleanups).toBe(0);
+  });
+});
+
+describe("McpServerPool shared STDIO processes (phase 4)", () => {
+  it("serves three clients from one process per server", async () => {
+    const connector = makeConnector();
+    process.env.METAMCP_SHARED_STDIO_PROCESSES = "1";
+    const shared = McpServerPool.createForTest({
+      connectClient: connector.connect as never,
+    });
+    delete process.env.METAMCP_SHARED_STDIO_PROCESSES;
+
+    vi.spyOn(configService, "getSessionLifetime").mockResolvedValue(60_000);
+    await shared.getSession("c1", SERVER_UUID, params);
+    await shared.getSession("c2", SERVER_UUID, params);
+    await shared.getSession("c3", SERVER_UUID, params);
+
+    expect(connector.stats.connectors).toBe(1);
+    await shared.cleanupAll();
+    expect(connector.stats.cleanups).toBe(1);
+  });
+
+  it("expires a shared session that has been idle past the lifetime", async () => {
+    const connector = makeConnector();
+    process.env.METAMCP_SHARED_STDIO_PROCESSES = "1";
+    const shared = McpServerPool.createForTest({
+      connectClient: connector.connect as never,
+    });
+    delete process.env.METAMCP_SHARED_STDIO_PROCESSES;
+
+    vi.spyOn(configService, "getSessionLifetime").mockResolvedValue(50);
+    await shared.getSession("c1", SERVER_UUID, params);
+    expect(connector.stats.connectors).toBe(1);
+
+    await new Promise((resolve) => setTimeout(resolve, 120));
+    await shared.runCleanupNow();
+
+    // A shared session is never released by its clients, so it must expire on
+    // idleness or it would hold a process for the life of the container.
+    expect(connector.stats.cleanups).toBe(1);
+    await shared.cleanupAll();
+  });
+});
+
+describe("McpServerPool cap scope", () => {
+  it("never refuses HTTP transports, which hold no process", async () => {
+    const connector = makeConnector();
+    const pooled = McpServerPool.createForTest({
+      connectClient: connector.connect as never,
+    });
+    vi.spyOn(configService, "getSessionLifetime").mockResolvedValue(60_000);
+
+    const httpParams: ServerParameters = {
+      ...params,
