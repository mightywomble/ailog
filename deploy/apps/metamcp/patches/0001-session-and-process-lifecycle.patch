@@ -0,0 +1,94 @@
+/**
+ * Lightweight in-process counters for MCP sessions and their child processes.
+ *
+ * Motivation: issue #324 was invisible for weeks because "sessions created"
+ * and "sessions closed" were only visible as log lines. Keeping the delta makes
+ * a leak self-evident (and `getSnapshot()` is what `/health/pool` reports).
+ */
+
+export interface SessionMetricsSnapshot {
+  sessionsCreated: number;
+  sessionsClosed: number;
+  /** created - closed; > 0 means sessions are accumulating */
+  liveSessions: number;
+  evictions: number;
+  rejectedByCap: number;
+  orphanSweeps: number;
+  orphansReaped: number;
+  oldestIdleSessionAgeMs: number | null;
+  liveChildProcesses: number;
+  liveChildRssBytes: number;
+}
+
+export class SessionMetrics {
+  private created = 0;
+  private closed = 0;
+  private evictions = 0;
+  private rejectedByCap = 0;
+  private orphanSweeps = 0;
+  private orphansReaped = 0;
+  private oldestIdleAgeMs: number | null = null;
+  private childCount = 0;
+  private childRssBytes = 0;
+
+  recordCreated(count = 1): void {
+    this.created += count;
+  }
+
+  recordClosed(count = 1): void {
+    this.closed += count;
+  }
+
+  recordEviction(): void {
+    this.evictions += 1;
+  }
+
+  recordCapRejection(): void {
+    this.rejectedByCap += 1;
+  }
+
+  recordSweep(reaped: number): void {
+    this.orphanSweeps += 1;
+    this.orphansReaped += reaped;
+  }
+
+  /** Sampled by the pool every time it reports status. */
+  setObservedState(state: {
+    oldestIdleAgeMs: number | null;
+    childCount: number;
+    childRssBytes: number;
+  }): void {
+    this.oldestIdleAgeMs = state.oldestIdleAgeMs;
+    this.childCount = state.childCount;
+    this.childRssBytes = state.childRssBytes;
+  }
+
+  getSnapshot(): SessionMetricsSnapshot {
+    return {
+      sessionsCreated: this.created,
+      sessionsClosed: this.closed,
+      liveSessions: Math.max(0, this.created - this.closed),
+      evictions: this.evictions,
+      rejectedByCap: this.rejectedByCap,
+      orphanSweeps: this.orphanSweeps,
+      orphansReaped: this.orphansReaped,
+      oldestIdleSessionAgeMs: this.oldestIdleAgeMs,
+      liveChildProcesses: this.childCount,
+      liveChildRssBytes: this.childRssBytes,
+    };
+  }
+
+  reset(): void {
+    this.created = 0;
+    this.closed = 0;
+    this.evictions = 0;
+    this.rejectedByCap = 0;
+    this.orphanSweeps = 0;
+    this.orphansReaped = 0;
+    this.oldestIdleAgeMs = null;
+    this.childCount = 0;
+    this.childRssBytes = 0;
+  }
+}
+
+export const sessionMetrics = new SessionMetrics();
