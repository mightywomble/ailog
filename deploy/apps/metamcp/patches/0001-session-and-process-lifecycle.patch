new file mode 100644
index 0000000..01ecc18
--- /dev/null
+++ b/apps/backend/src/lib/session-lifetime-policy.ts
@@ -0,0 +1,62 @@
+/**
+ * Session lifetime policy.
+ *
+ * Until 2.4.22 the lifetime came straight from the `config` row and an absent
+ * row meant "infinite" — which silently disabled every session reaper (see
+ * issues #324 and the idle-session cleanup added in 2.4.15). A missing row is
+ * the normal state of a fresh install, so in practice nothing was ever evicted
+ * and sessions accumulated for the lifetime of the container.
+ *
+ * The policy below keeps an explicit opt-out but makes the default finite:
+ *
+ *   row absent / empty / unparsable  -> DEFAULT_SESSION_LIFETIME_MS (30 min)
+ *   row = 0 or negative              -> null (never expire, previous behaviour)
+ *
+ * `METAMCP_SESSION_LIFETIME_MS` overrides the stored row (same semantics) so an
+ * operator can change the value without editing the database.
+ */
+export const DEFAULT_SESSION_LIFETIME_MS = 30 * 60 * 1000; // 30 minutes
+
+export const SESSION_LIFETIME_ENV = "METAMCP_SESSION_LIFETIME_MS";
+
+/**
+ * Resolve the effective session lifetime in milliseconds.
+ *
+ * @param storedValue raw `SESSION_LIFETIME` value from the config table, if any
+ * @param envValue    raw `METAMCP_SESSION_LIFETIME_MS` value, if any
+ * @returns lifetime in ms, or `null` for "sessions never expire"
+ */
+export function resolveSessionLifetime(
+  storedValue?: string | null,
+  envValue?: string | null,
+): number | null {
+  const explicit = parseLifetime(envValue);
+  if (explicit !== undefined) {
+    return explicit;
+  }
+
+  const stored = parseLifetime(storedValue);
+  if (stored !== undefined) {
+    return stored;
+  }
+
+  return DEFAULT_SESSION_LIFETIME_MS;
+}
+
+/**
+ * @returns the parsed lifetime, `null` for the infinite opt-out, or
+ *          `undefined` when the input carries no usable value.
+ */
+function parseLifetime(raw?: string | null): number | null | undefined {
+  if (raw === undefined || raw === null) return undefined;
+  const trimmed = raw.trim();
+  if (trimmed === "") return undefined;
+
+  const parsed = Number.parseInt(trimmed, 10);
+  if (Number.isNaN(parsed)) return undefined;
+
+  // 0 / negative is the documented opt-out: keep sessions forever.
+  if (parsed <= 0) return null;
+
+  return parsed;
+}
