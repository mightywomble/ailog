+import { describe, expect, it } from "vitest";
+
+import {
+  DEFAULT_SESSION_LIFETIME_MS,
+  resolveSessionLifetime,
+  SESSION_LIFETIME_ENV,
+} from "./session-lifetime-policy";
+
+describe("resolveSessionLifetime", () => {
+  it("defaults to a finite lifetime when no row exists", () => {
+    // Regression: an absent SESSION_LIFETIME row used to mean `null`
+    // ("never expire"), which disabled every reaper (#324).
+    expect(resolveSessionLifetime(undefined, undefined)).toBe(
+      DEFAULT_SESSION_LIFETIME_MS,
+    );
+    expect(resolveSessionLifetime(null, undefined)).toBe(
+      DEFAULT_SESSION_LIFETIME_MS,
+    );
+    expect(resolveSessionLifetime("", undefined)).toBe(
+      DEFAULT_SESSION_LIFETIME_MS,
+    );
+    expect(resolveSessionLifetime("not-a-number", undefined)).toBe(
+      DEFAULT_SESSION_LIFETIME_MS,
+    );
+    expect(DEFAULT_SESSION_LIFETIME_MS).toBe(30 * 60 * 1000);
+  });
+
+  it("honours a stored value", () => {
+    expect(resolveSessionLifetime("60000", undefined)).toBe(60_000);
+  });
+
+  it("treats 0 / negative as an explicit opt-out (never expire)", () => {
+    expect(resolveSessionLifetime("0", undefined)).toBeNull();
+    expect(resolveSessionLifetime("-5", undefined)).toBeNull();
+  });
+
+  it("lets the env var win over the stored row", () => {
+    expect(resolveSessionLifetime("60000", "120000")).toBe(120_000);
+    expect(resolveSessionLifetime("60000", "0")).toBeNull();
+    // an empty env var must not clobber the stored value
+    expect(resolveSessionLifetime("60000", "")).toBe(60_000);
+  });
+
+  it("exposes the env var name it reads", () => {
+    expect(SESSION_LIFETIME_ENV).toBe("METAMCP_SESSION_LIFETIME_MS");
+  });
+});
