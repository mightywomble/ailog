 });
 
 app.get("/health", (req, res) => {
@@ -108,3 +124,104 @@ app.get("/health", (req, res) => {
     status: "ok",
   });
 });
+
+/**
+ * Pool/session/process observability. Answers "is it leaking right now?":
+ * `liveSessions` (created - closed) should stay flat, `oldestIdleSessionAgeMs`
+ * should never exceed SESSION_LIFETIME by much, and `liveChildRssBytes` is the
+ * memory the STDIO MCP servers are holding.
+ */
+app.get("/health/pool", async (req, res) => {
+  const [metrics, mcpPool, metaPool] = await Promise.all([
+    mcpServerPool.getMetricsSnapshot(),
+    Promise.resolve(mcpServerPool.getPoolStatus()),
+    Promise.resolve(metaMcpServerPool.getPoolStatus()),
+  ]);
+  res.json({
+    timestamp: new Date().toISOString(),
+    metrics,
+    mcpServerPool: mcpPool,
+    metaMcpServerPool: metaPool,
+    trackedProcessGroups: processGroupRegistry.list().length,
+  });
+});
+
+const ORPHAN_SWEEP_INTERVAL_MS = Number.parseInt(
+  process.env.METAMCP_ORPHAN_SWEEP_INTERVAL_MS ?? "60000",
+  10,
+);
+
+const sweepTimer = setInterval(
+  () => {
+    void (async () => {
+      try {
+        const result = await processGroupRegistry.sweep();
+        if (result.reaped.length > 0) {
+          console.warn(
+            `[sweep] reaped ${result.reaped.length} orphaned process group(s): ` +
+              result.reaped
+                .map(
+                  (g) =>
+                    `${g.pid} (${g.label}, age ${Math.round(g.ageMs / 1000)}s)`,
+                )
+                .join(", "),
+          );
+        }
+      } catch (error) {
+        console.error("[sweep] orphan sweep failed:", error);
+      }
+    })();
+  },
+  Number.isNaN(ORPHAN_SWEEP_INTERVAL_MS) ? 60000 : ORPHAN_SWEEP_INTERVAL_MS,
+);
+sweepTimer.unref();
+
+/**
+ * Graceful shutdown: without this nothing signalled the detached MCP process
+ * groups, so every `docker stop` (and every `kill` of the app) left the STDIO
+ * servers running until the container's PID 1 went away (#128 residuals).
+ */
+let shuttingDown = false;
+const shutdown = async (signal: string) => {
+  if (shuttingDown) return;
+  shuttingDown = true;
+  console.log(
+    `[shutdown] received ${signal}, closing sessions and process groups…`,
+  );
+
+  const timeout = setTimeout(() => {
+    console.error("[shutdown] timed out after 10s, exiting anyway");
+    // eslint-disable-next-line no-process-exit -- shutdown path
+    process.exit(1);
+  }, 10_000);
+  timeout.unref();
+
+  try {
+    await metaMcpServerPool.cleanupAll();
+  } catch (error) {
+    console.error("[shutdown] error cleaning up MetaMCP pool:", error);
+  }
+
+  try {
+    // Anything the pools lost track of, plus groups still alive.
+    const result = await processGroupRegistry.sweep({ minAgeMs: 0 });
+    for (const group of processGroupRegistry.list()) {
+      await processGroupRegistry.terminateGroup(group.pid, 2000);
+      processGroupRegistry.unregister(group.pid);
+    }
+    if (result.reaped.length > 0) {
+      console.log(
+        `[shutdown] reaped ${result.reaped.length} orphaned group(s)`,
+      );
+    }
+  } catch (error) {
+    console.error("[shutdown] error sweeping process groups:", error);
+  }
+
+  clearTimeout(timeout);
+  // eslint-disable-next-line no-process-exit -- shutdown path
+  process.exit(0);
+};
+
+process.once("SIGTERM", () => void shutdown("SIGTERM"));
+process.once("SIGINT", () => void shutdown("SIGINT"));
