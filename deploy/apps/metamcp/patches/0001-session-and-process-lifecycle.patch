index 0000000..1e06824
--- /dev/null
+++ b/apps/backend/src/lib/stdio-transport/process-registry.ts
@@ -0,0 +1,182 @@
+import fs from "node:fs";
+import process from "node:process";
+
+/**
+ * Registry of the process groups we created for STDIO MCP servers.
+ *
+ * Every child is spawned `detached`, so it leads its own process group and
+ * `kill(-pid)` reaches the whole tree (`npm exec` → `node`, `uvx` → `python`).
+ * That only helps if we still know the pid: `ProcessManagedStdioTransport`
+ * used to drop the reference the moment it sent SIGTERM, so a grandchild that
+ * ignored the signal became unreachable and survived as PPID=1 (#128).
+ *
+ * The registry keeps those pids (and a label for logging) so the transport can
+ * escalate to SIGKILL and a periodic sweep can reap leftovers. It never kills a
+ * pid it did not register itself.
+ */
+
+export interface TrackedProcessGroup {
+  /** pid of the process-group leader (the direct child we spawned) */
+  pid: number;
+  /** human-readable origin, e.g. `server=git-mcp session=…` */
+  label: string;
+  /** epoch ms when the group was spawned */
+  startedAt: number;
+}
+
+export interface SweepResult {
+  /** groups whose leader was gone but which still had members: killed */
+  reaped: Array<{ pid: number; label: string; ageMs: number }>;
+  /** entries dropped because the whole group was already gone */
+  forgotten: number[];
+}
+
+const DEFAULT_SWEEP_MIN_AGE_MS = 30_000;
+
+export class ProcessGroupRegistry {
+  private groups = new Map<number, TrackedProcessGroup>();
+
+  register(pid: number, label: string): void {
+    if (!Number.isInteger(pid) || pid <= 0) return;
+    this.groups.set(pid, { pid, label, startedAt: Date.now() });
+  }
+
+  unregister(pid: number): void {
+    this.groups.delete(pid);
+  }
+
+  has(pid: number): boolean {
+    return this.groups.has(pid);
+  }
+
+  list(): TrackedProcessGroup[] {
+    return Array.from(this.groups.values());
+  }
+
+  get size(): number {
+    return this.groups.size;
+  }
+
+  clear(): void {
+    this.groups.clear();
+  }
+
+  /**
+   * Is any process left in the group? `process.kill(-pid, 0)` succeeds as long
+   * as at least one member exists, which is exactly what we need: the leader may
+   * be a zombie (reaped by node shortly after) while grandchildren still run.
+   */
+  isGroupAlive(pid: number): boolean {
+    try {
+      process.kill(-pid, 0);
+      return true;
+    } catch (error) {
+      return (error as NodeJS.ErrnoException).code === "EPERM";
+    }
+  }
+
+  /**
+   * Kill the whole group: SIGTERM, wait up to `graceMs`, then SIGKILL.
+   * Resolves true when the group is gone afterwards.
+   */
+  async terminateGroup(pid: number, graceMs: number): Promise<boolean> {
+    if (!this.isGroupAlive(pid)) return true;
+
+    this.signalGroup(pid, "SIGTERM");
+    if (await this.waitForGroupExit(pid, graceMs)) return true;
+
+    this.signalGroup(pid, "SIGKILL");
+    return this.waitForGroupExit(pid, Math.max(1000, graceMs));
+  }
+
+  /**
+   * Reap groups whose leader has exited but whose members are still running.
+   * This is the "direct child exited but grandchildren survived" case from
+   * #128, plus anything a failed connect attempt left behind.
+   */
+  async sweep(options?: {
+    minAgeMs?: number;
+    graceMs?: number;
+  }): Promise<SweepResult> {
+    const minAgeMs = options?.minAgeMs ?? DEFAULT_SWEEP_MIN_AGE_MS;
+    const graceMs = options?.graceMs ?? 3000;
+    const now = Date.now();
+    const result: SweepResult = { reaped: [], forgotten: [] };
+
+    for (const group of Array.from(this.groups.values())) {
+      const ageMs = now - group.startedAt;
+
+      if (!this.isGroupAlive(group.pid)) {
+        this.groups.delete(group.pid);
+        result.forgotten.push(group.pid);
+        continue;
+      }
+
+      // Never touch a group younger than the grace window: it may still be
+      // starting up and its leader alive but slow to appear.
+      if (ageMs < minAgeMs) continue;
+
+      const leaderAlive = isProcessAlive(group.pid);
+      if (leaderAlive) continue;
+
+      await this.terminateGroup(group.pid, graceMs);
+      this.groups.delete(group.pid);
+      result.reaped.push({ pid: group.pid, label: group.label, ageMs });
+    }
+
+    return result;
+  }
+
+  private signalGroup(pid: number, signal: NodeJS.Signals): void {
+    try {
+      process.kill(-pid, signal);
+    } catch (error) {
+      const code = (error as NodeJS.ErrnoException).code;
+      if (code !== "ESRCH") {
+        console.warn(
+          `[process-registry] failed to send ${signal} to group ${pid}:`,
+          (error as Error).message,
+        );
+      }
+    }
+  }
+
+  private async waitForGroupExit(
+    pid: number,
+    timeoutMs: number,
+  ): Promise<boolean> {
+    const deadline = Date.now() + timeoutMs;
+    while (Date.now() < deadline) {
+      if (!this.isGroupAlive(pid)) return true;
+      await new Promise((resolve) => setTimeout(resolve, 50));
+    }
+    return !this.isGroupAlive(pid);
+  }
+}
+
+/** `kill(pid, 0)` — true when the process exists (zombies included). */
+export function isProcessAlive(pid: number): boolean {
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (error) {
+    return (error as NodeJS.ErrnoException).code === "EPERM";
+  }
+}
+
+/**
+ * Resident set size of a pid in bytes, read from /proc (Linux only).
+ * Returns undefined when unavailable — callers must not treat 0 as "dead".
+ */
+export function readRssBytes(pid: number): number | undefined {
+  try {
+    const status = fs.readFileSync(`/proc/${pid}/status`, "utf8");
+    const match = /VmRSS:\s+(\d+)\s+kB/.exec(status);
+    if (!match) return undefined;
+    return Number.parseInt(match[1], 10) * 1024;
+  } catch {
+    return undefined;
+  }
+}
+
+export const processGroupRegistry = new ProcessGroupRegistry();
