+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+import { afterAll, describe, expect, it } from "vitest";
+
+import { ProcessManagedStdioTransport } from "./process-managed-transport";
+import { isProcessAlive, processGroupRegistry } from "./process-registry";
+
+const isLinux = process.platform === "linux";
+const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), "metamcp-stdio-test-"));
+const stubbornScript = path.join(tmpDir, "stubborn.sh");
+
+// Parent and grandchild both ignore SIGTERM, so only SIGKILL can reap the group.
+fs.writeFileSync(
+  stubbornScript,
+  `#!/bin/sh
+trap '' TERM
+sh -c 'trap "" TERM; sleep 300' &
+wait
+`,
+  { mode: 0o755 },
+);
+
+afterAll(() => {
+  fs.rmSync(tmpDir, { recursive: true, force: true });
+});
+
+describe.skipIf(!isLinux)("ProcessManagedStdioTransport.close", () => {
+  it("kills the whole process group, not just the direct child (#128)", async () => {
+    const transport = new ProcessManagedStdioTransport(
+      { command: "/bin/sh", args: [stubbornScript], stderr: "pipe" },
+      { killGraceMs: 400 },
+    );
+
+    await transport.start();
+    const pid = transport.pid ?? 0;
+    expect(pid).toBeGreaterThan(0);
+    expect(processGroupRegistry.has(pid)).toBe(true);
+
+    // Give the script a moment to fork its stubborn grandchild.
+    await new Promise((resolve) => setTimeout(resolve, 300));
+    expect(processGroupRegistry.isGroupAlive(pid)).toBe(true);
+
+    const startedAt = Date.now();
+    await transport.close();
+    const elapsed = Date.now() - startedAt;
+
+    // Only SIGTERM was sent before; both processes ignore it, so close() must
+    // have escalated to SIGKILL — which also means it waited for the grace.
+    expect(elapsed).toBeGreaterThanOrEqual(350);
+    expect(processGroupRegistry.isGroupAlive(pid)).toBe(false);
+    expect(processGroupRegistry.has(pid)).toBe(false);
+  });
+
+  it("closes quickly when the child honours SIGTERM", async () => {
+    const transport = new ProcessManagedStdioTransport(
+      { command: "/bin/sh", args: ["-c", "sleep 300"], stderr: "pipe" },
+      { killGraceMs: 3000 },
+    );
+
+    await transport.start();
+    const pid = transport.pid ?? 0;
+    const startedAt = Date.now();
+    await transport.close();
+
+    expect(Date.now() - startedAt).toBeLessThan(1500);
+    expect(processGroupRegistry.isGroupAlive(pid)).toBe(false);
+  });
+
+  it("sweeps a group whose leader died but whose members survive", async () => {
+    // Leader exits immediately, grandchild stays in the same process group.
+    const transport = new ProcessManagedStdioTransport(
+      {
+        command: "/bin/sh",
+        args: ["-c", "sh -c 'sleep 300' & exit 0"],
+        stderr: "pipe",
+      },
+      { killGraceMs: 400 },
+    );
+
+    await transport.start();
+    const pid = transport.pid ?? 0;
+    await new Promise((resolve) => setTimeout(resolve, 400));
+
+    // Leader is gone, group members remain: exactly the orphan case.
+    expect(isProcessAlive(pid)).toBe(false);
+    const sweep = await processGroupRegistry.sweep({
+      minAgeMs: 0,
+      graceMs: 400,
+    });
+
+    expect(sweep.reaped.map((group) => group.pid)).toContain(pid);
+    expect(processGroupRegistry.isGroupAlive(pid)).toBe(false);
+    processGroupRegistry.unregister(pid);
+  });
+});
