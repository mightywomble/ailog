# The keys /home/david/code/immich/.env must define. The real file lives on the
# `photos` host and is never committed - it holds the database password.
#
# Requirement is checkable: the compose workflow refuses to deploy a project
# whose .env is missing any key listed in project.json's env_keys.

# Where uploads are stored, relative to the project directory
UPLOAD_LOCATION=./library

# Where the database files are stored (must be local disk, not a network share)
DB_DATA_LOCATION=./postgres

# Note: the immich version is NOT here. It is pinned in compose.yml, because a
# variable in this file outranked the pin and the project kept pulling `:v3`
# after the compose file said v3.3.6. Bumping immich is a commit now.

# Credentials - set once when the project was created
DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
